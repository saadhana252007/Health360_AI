<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#F5FAFA">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Your Health Screening"
            android:textColor="#155E63"
            android:textSize="30sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="A summary of your symptoms, vital signs and AI-assisted screening results."
            android:textColor="#607078"
            android:textSize="16sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="OVERALL SCREENING"
            android:textColor="#155E63"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/mainConcernValue"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:textColor="#17202A"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/screeningSummaryValue"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="#E4F3F1"
            android:padding="18dp"
            android:textColor="#155E63"
            android:textSize="17sp" />

        <TextView
            android:id="@+id/triageValue"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="#FFFFFF"
            android:padding="18dp"
            android:textColor="#17202A"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:text="WHAT WE FOUND"
            android:textColor="#155E63"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/symptomFindingValue"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textColor="#17202A"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/symptomConfidenceValue"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="#607078"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/symptomDetailsValue"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="#FFFFFF"
            android:padding="18dp"
            android:textColor="#17202A"
            android:textSize="16sp"
            android:lineSpacingExtra="5dp" />

        <LinearLayout
            android:id="@+id/redFlagsSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:orientation="vertical"
            android:background="#FFF0F0"
            android:padding="18dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="WARNING SIGNS"
                android:textColor="#A32222"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/redFlagsValue"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:textColor="#5F2020"
                android:textSize="16sp"
                android:lineSpacingExtra="5dp" />

        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:text="RECORDED VITALS"
            android:textColor="#155E63"
            android:textSize="22sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="#FFFFFF"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Heart Rate"
                android:textColor="#607078"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/heartRateValue"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#17202A"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:text="Blood Pressure"
                android:textColor="#607078"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/bloodPressureValue"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#17202A"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:text="SpO₂"
                android:textColor="#607078"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/spo2Value"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#17202A"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:text="Temperature"
                android:textColor="#607078"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/temperatureValue"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#17202A"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/vitalsInterpretationValue"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:textColor="#155E63"
                android:textSize="15sp"
                android:lineSpacingExtra="5dp" />

        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:text="CARDIOVASCULAR RISK SCREENING"
            android:textColor="#155E63"
            android:textSize="22sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="#FFFFFF"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:id="@+id/patientFindingValue"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#17202A"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/patientConfidenceValue"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textColor="#607078"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/patientExplanationValue"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:textColor="#46545C"
                android:textSize="15sp"
                android:lineSpacingExtra="5dp" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/imageResultSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="IMAGE SCREENING"
                android:textColor="#155E63"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/imageTypeValue"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:textColor="#607078"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/imageFindingValue"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="#17202A"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/imageConfidenceValue"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:textColor="#607078"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/imageProbabilitiesValue"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="#FFFFFF"
                android:padding="18dp"
                android:textColor="#17202A"
                android:textSize="15sp"
                android:lineSpacingExtra="6dp" />

            <TextView
                android:id="@+id/imageExplanationValue"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="#FFFFFF"
                android:padding="18dp"
                android:textColor="#46545C"
                android:textSize="15sp" />

        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:text="HOW THE AI REACHED THIS RESULT"
            android:textColor="#155E63"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/aiAssessmentValue"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="#FFFFFF"
            android:padding="18dp"
            android:textColor="#46545C"
            android:textSize="15sp"
            android:lineSpacingExtra="7dp" />

        <TextView
            android:id="@+id/overallExplanationValue"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="#E4F3F1"
            android:padding="18dp"
            android:textColor="#155E63"
            android:textSize="15sp"
            android:lineSpacingExtra="5dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:text="ASSESSMENT QUALITY"
            android:textColor="#155E63"
            android:textSize="22sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="#FFFFFF"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Required input completeness"
                android:textColor="#607078"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/completenessValue"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="#17202A"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:text="Model uncertainty"
                android:textColor="#607078"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/uncertaintyValue"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="#17202A"
                android:textSize="20sp"
                android:textStyle="bold" />

        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:text="WHAT TO DO NEXT"
            android:textColor="#155E63"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/nextStepsValue"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="#FFFFFF"
            android:padding="18dp"
            android:textColor="#17202A"
            android:textSize="16sp"
            android:lineSpacingExtra="6dp" />

        <TextView
            android:id="@+id/disclaimerText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:textColor="#607078"
            android:textSize="14sp"
            android:lineSpacingExtra="5dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/askAiButton"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="18dp"
            android:text="Ask Health360 AI"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="17sp"
            android:textStyle="bold"
            app:backgroundTint="#087C83"
            app:cornerRadius="25dp" />


        <com.google.android.material.button.MaterialButton
            android:id="@+id/backHomeButton"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="6dp"
            android:text="Back to Home"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold"
            app:backgroundTint="#0D7A7F"
            app:cornerRadius="25dp" />

    </LinearLayout>

</ScrollView>