Rows under the table are available only if they have been created within the last 24 hours.`,statement:`
create policy "Stories are live for a day"
on "${e}"."${s}"
for select using (
  created_at > (current_timestamp - interval '1 day')
);
`.trim(),definition:t.safeSql`created_at > (current_timestamp - interval '1 day')`,check:t.safeSql``,command:"SELECT",roles:[]},{id:"policy-8",preview:!1,templateName:"Allow users to only view their own data",description:"Restrict users to reading only their own data.",statement:`
